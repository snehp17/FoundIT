PORT=5000

# ─────────────────────────────────────────
# Supabase Configuration
# Get these from: Supabase Dashboard → Project Settings → API
# ─────────────────────────────────────────

# Your Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Service Role Key (keeps server-side DB access secure, bypasses RLS)
# ⚠️  Never expose this in the frontend
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# JWT Secret for local token verification (no clock issues)
# Get from: Supabase Dashboard → Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ─────────────────────────────────────────
# AI Configuration
# ─────────────────────────────────────────

# Google Gemini API Key (used for AI support chat, item categorization, auto-description)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ─────────────────────────────────────────
# Setup Instructions for New Team Members
# ─────────────────────────────────────────
# 1. Copy this file → rename it to .env
# 2. Fill in the values above (ask the team lead for the actual keys)
# 3. Run: npm install
# 4. Run: npm start
