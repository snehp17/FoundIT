{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/images/*", "*.{png,jpg,gif,svg,ico,css,js}"]
  },
  "routes": [
    {
      "route": "/reset-password",
      "rewrite": "/index.html"
    },
    {
      "route": "/login",
      "rewrite": "/index.html"
    },
    {
      "route": "/google-callback",
      "rewrite": "/index.html"
    },
    {
      "route": "/uni-admin",
      "rewrite": "/index.html"
    },
    {
      "route": "/admin",
      "rewrite": "/index.html"
    },
    {
      "route": "/dashboard",
      "rewrite": "/index.html"
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html",
      "statusCode": 200
    }
  }
}
